# =============================================================================
# .gitignore for Tailwind CSS & Frontend Styling Projects
# =============================================================================

# Dependencies (Tailwind CLI, PostCSS, LightningCSS)
node_modules/
.npm/
.pnpm-store/
.pnp
.pnp.*

# Bundler & Linter Caches
# (Note: compiled CSS files like src/output.css or css/*.css used directly
# by static HTML lessons are intentionally NOT ignored)
dist/
build/
.parcel-cache/
.vite/
.cache/
.stylelintcache
.prettiercache
.eslintcache

# Environment Variables
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Logs & Temp Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.bak

# IDEs & Editors
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets
.idea/
*.iml
*.sw?

# Operating System
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
